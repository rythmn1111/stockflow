{
  "name": "stockflow",
  "productName": "StockFlow",
  "version": "0.1.0",
  "description": "Offline-first stock register and material planning for small manufacturers",
  "main": "./out/main/index.js",
  "author": "StockFlow",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "bun run typecheck && electron-vite build",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "smoke": "bun run smoke:db && bun run smoke:planning && bun run smoke:packing",
    "smoke:db": "bun build scripts/smoke-db.ts --target=node --outfile=node_modules/.stockflow/smoke-db.mjs && node node_modules/.stockflow/smoke-db.mjs",
    "smoke:planning": "bun build scripts/smoke-planning.ts --target=node --outfile=node_modules/.stockflow/smoke-planning.mjs && node node_modules/.stockflow/smoke-planning.mjs",
    "smoke:packing": "bun build scripts/smoke-packing.ts --target=node --outfile=node_modules/.stockflow/smoke-packing.mjs && node node_modules/.stockflow/smoke-packing.mjs",
    "seed:demo": "bun build scripts/seed-demo.ts --target=node --outfile=node_modules/.stockflow/seed.mjs && node node_modules/.stockflow/seed.mjs",
    "package": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^38",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.34.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "zustand": "^5.0.15",
    "@radix-ui/react-toggle-group": "^1.1.19"
  }
}
